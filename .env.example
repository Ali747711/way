# Used only by `npm run content:generate` on your machine; never exposed to the app.
# Provider precedence: OPENROUTER_API_KEY wins if both keys are set.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override, e.g. anthropic/claude-sonnet-5.5 (OpenRouter) or claude-sonnet-5-5 (Anthropic).
GENERATE_MODEL=
# Public URL of the project repository, shown as a link in the site footer.
NEXT_PUBLIC_REPO_URL=
